PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amp_reviewbot
DATABASE_SSL=false

GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-me

AMP_API_KEY=replace-me
# Optional JSON overrides. Repositories default to an Amp project with the same owner/name.
AMP_PROJECTS={"owner/repository":"workspace/project"}
AMP_THREAD_VISIBILITY=private

WORKER_CONCURRENCY=2
REVIEW_TIMEOUT_MINUTES=30
FAIL_ON=high
LOG_LEVEL=info
